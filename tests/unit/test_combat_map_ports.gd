func test_las_fachadas_reales_implementan_los_puertos_de_combate() -> void:
	var map := MapArea.new()
	assert_is(CombatMapQueries.new().line_of_sight, LineOfSightPort)
	assert_is(CombatMapQueries.new().actors, ActorQueriesPort)
	assert_is(CombatMapQueries.new().areas, AreaQueriesPort)
	assert_is(CombatMapActors.new().presentation, CombatMapActorPresentationAdapter)
	assert_is(CombatMapActors.new().movement, CombatMapActorMovementAdapter)
	assert_is(CombatMapActors.new().state, CombatMapActorStateAdapter)
	assert_is(CombatMapActors.new().state.geometry, CombatMapActorGeometryAdapter)
	assert_is(CombatMapActors.new().state.targets, CombatMapActorTargetsAdapter)
	assert_is(CombatMapActors.new().state.configuration, CombatMapActorConfigurationAdapter)
	assert_is(CombatMapPresentation.new().patterns, PatternPort)
	assert_is(CombatMapPresentation.new().targeting, TargetingPresentationPort)
	assert_is(CombatMapPresentation.new().targeting.overlay, CombatMapTargetingOverlayAdapter)
	assert_is(CombatMapPresentation.new().targeting.overlay.ranges, CombatMapTargetingRangeAdapter)
	assert_is(CombatMapPresentation.new().targeting.overlay.path, CombatMapTargetingPathAdapter)
	assert_is(CombatMapPresentation.new().targeting.overlay.actors, CombatMapTargetingActorHighlightsAdapter)
	assert_is(CombatMapPresentation.new().targeting.hover, TargetingHoverPort)
	assert_is(CombatMapPresentation.new().overlay_port, OverlayPort)
	assert_is(CombatMapPresentation.new().combat_preview, PreviewPort)
	assert_is(CombatMapPresentation.new().overwatch, OverwatchPort)
	assert_is(CombatMapPresentation.new().puddle, PuddleVisualPort)
	assert_is(CombatMapMovement.new(), MovementPort)
	assert_is(CombatMapTerrain.new(), TerrainPort)
	assert_is(CombatMapTerrain.new().navigation, TerrainNavigationPort)
	assert_is(CombatMapTerrain.new().geometry, TerrainGeometryPort)
	assert_is(CombatMapTerrain.new().geometry.bounds, CombatMapTerrainBoundsAdapter)
	assert_is(CombatMapTerrain.new().geometry.collision, TerrainCollisionPort)
	assert_is(CombatMapTerrain.new().geometry.spatial, CombatMapTerrainSpatialAdapter)
	assert_is(CombatMapTerrain.new().mutation, CombatMapTerrainMutationAdapter)
	assert_is(map.selection, SelectionPort)
	assert_is(map.selection.targeting, SelectionTargetingPort)
	assert_is(map.selection.targeting.hover, CombatMapSelectionHoverAdapter)
	assert_is(map.selection.targeting.modes, CombatMapSelectionModesTargetingAdapter)
	assert_is(map.selection.targeting.queries, CombatMapTargetQueriesAdapter)
	assert_is(map.selection.actions, SelectionActionsPort)
	assert_is(map.selection.actions.modes, CombatMapSelectionModesAdapter)
	assert_is(map.selection.actions.modes.terrain, CombatMapSelectionTerrainModesAdapter)
	assert_is(map.selection.actions.modes.actions, CombatMapSelectionActionModesAdapter)
	assert_is(map.selection.actions.overwatch, CombatMapOverwatchSelectionAdapter)
	assert_is(map.selection, CombatMapSelectionAdapter)
	assert_is(map.placement, PlacementPort)
	assert_is(map.placement.traps, CombatMapTrapPlacementAdapter)
	assert_is(map.placement.grenades, CombatMapGrenadePlacementAdapter)
	assert_is(map.placement.puddles, CombatMapPuddlePlacementAdapter)
	assert_is(map.effects, EffectsPort)
	assert_is(map.effects.traps, CombatMapTrapEffectsAdapter)
	assert_is(map.effects.puddle_port, CombatMapPuddleEffectsAdapter)
	assert_is(map.effects.puddle_port.queries, CombatMapPuddleQueriesAdapter)
	assert_is(map.effects.puddle_port.mutation, CombatMapPuddleMutationAdapter)
	assert_is(map.effects.puddle_port.zones, CombatMapPuddleZoneEffectsAdapter)
	assert_is(map.effects.delayed, CombatMapDelayedEffectsAdapter)
	assert_is(map.obstacles, ObstaclePort)
	assert_is(map.obstacles.rocks, CombatMapRockAdapter)
	assert_is(map.obstacles.modules, CombatMapModuleAdapter)
	assert_is(map.obstacles.trees, CombatMapTreeAdapter)
	assert_is(map.obstacles.trees.queries, CombatMapTreeQueriesAdapter)
	assert_is(map.obstacles.trees.movement, CombatMapTreeMovementAdapter)
	assert_is(map.obstacles.trees.effects, CombatMapTreeEffectsAdapter)
	assert_is(map.push, PushPort)
	assert_is(map.push.selection, CombatMapPushSelectionAdapter)
	assert_is(map.push.queries, CombatMapPushQueriesAdapter)
	assert_is(map.push.execution, CombatMapPushExecutionAdapter)
	assert_is(map.push.modules, CombatMapPushModulesAdapter)
	assert_is(map.scene, CombatMapSceneAdapter)
	assert_is(map.scene.actors, CombatMapSceneActorsAdapter)
	assert_is(map.scene.presentation, CombatMapScenePresentationAdapter)
	assert_is(map.scene.input, CombatMapSceneInputAdapter)
	var enemy_board := CombatEnemyBoardMapAdapter.new(map)
	assert_is(enemy_board, EnemyBoardPort)
	assert_is(enemy_board.state, CombatEnemyBoardStateAdapter)
	assert_is(enemy_board.queries, CombatEnemyBoardQueriesAdapter)
	assert_is(enemy_board.effects, CombatEnemyBoardEffectsAdapter)
	assert_is(enemy_board.movement, CombatEnemyBoardMovementAdapter)
	assert_is(map.state, CombatMapStateAdapter)
	assert_is(map.construction, CombatMapConstructionAdapter)
	map.player_pos = Vector2(4.0, 5.0)
	assert_eq(map.state.player_position(), Vector2(4.0, 5.0))
	map.free()


func test_el_adaptador_del_tablero_enemigo_implementa_su_puerto() -> void:
	var map_area := CombatMapArea.new()
	assert_is(CombatEnemyBoardMapAdapter.new(map_area), EnemyBoardPort)
	map_area.free()
