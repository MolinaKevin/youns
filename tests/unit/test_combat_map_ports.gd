func test_las_fachadas_reales_implementan_los_puertos_de_combate() -> void:
	var map := MapArea.new()
	assert_is(CombatMapQueries.new(), QueriesPort)
	assert_is(CombatMapQueries.new().line_of_sight, LineOfSightPort)
	assert_is(CombatMapQueries.new().actors, ActorQueriesPort)
	assert_is(CombatMapQueries.new().areas, AreaQueriesPort)
	assert_is(CombatMapActors.new(), ActorsPort)
	assert_is(CombatMapActors.new().presentation, ActorPresentationPort)
	assert_is(CombatMapActors.new().movement, ActorMovementPort)
	assert_is(CombatMapActors.new().state, ActorStatePort)
	assert_is(CombatMapActors.new().state.geometry, ActorGeometryPort)
	assert_is(CombatMapActors.new().state.targets, ActorTargetsPort)
	assert_is(CombatMapActors.new().state.configuration, ActorConfigurationPort)
	assert_is(CombatMapPresentation.new(), PresentationPort)
	assert_is(CombatMapPresentation.new().patterns, PatternPort)
	assert_is(CombatMapPresentation.new().targeting, TargetingPresentationPort)
	assert_is(CombatMapPresentation.new().targeting.overlay, TargetingOverlayPort)
	assert_is(CombatMapPresentation.new().targeting.overlay.ranges, TargetingRangePort)
	assert_is(CombatMapPresentation.new().targeting.overlay.path, TargetingPathPort)
	assert_is(CombatMapPresentation.new().targeting.overlay.actors, TargetingActorHighlightsPort)
	assert_is(CombatMapPresentation.new().targeting.hover, TargetingHoverPort)
	assert_is(CombatMapPresentation.new().overlay_port, OverlayPort)
	assert_is(CombatMapPresentation.new().combat_preview, PreviewPort)
	assert_is(CombatMapPresentation.new().overwatch, OverwatchPort)
	assert_is(CombatMapMovement.new(), MovementPort)
	assert_is(CombatMapTerrain.new(), TerrainPort)
	assert_is(CombatMapTerrain.new().navigation, TerrainNavigationPort)
	assert_is(CombatMapTerrain.new().geometry, TerrainGeometryPort)
	assert_is(CombatMapTerrain.new().geometry.bounds, TerrainBoundsPort)
	assert_is(CombatMapTerrain.new().geometry.collision, TerrainCollisionPort)
	assert_is(CombatMapTerrain.new().geometry.spatial, TerrainSpatialPort)
	assert_is(CombatMapTerrain.new().mutation, TerrainMutationPort)
	assert_is(map.selection, SelectionPort)
	assert_is(map.selection.targeting, SelectionTargetingPort)
	assert_is(map.selection.targeting.hover, SelectionHoverPort)
	assert_is(map.selection.targeting.modes, SelectionModesTargetingPort)
	assert_is(map.selection.targeting.queries, TargetQueriesPort)
	assert_is(map.selection.actions, SelectionActionsPort)
	assert_is(map.selection.actions.modes, SelectionModesPort)
	assert_is(map.selection.actions.modes.terrain, SelectionTerrainModesPort)
	assert_is(map.selection.actions.modes.actions, SelectionActionModesPort)
	assert_is(map.selection.actions.overwatch, OverwatchSelectionPort)
	assert_is(map.selection, CombatMapSelectionAdapter)
	assert_is(map.placement, PlacementPort)
	assert_is(map.placement.traps, TrapPlacementPort)
	assert_is(map.placement.grenades, GrenadePlacementPort)
	assert_is(map.placement.puddles, PuddlePlacementPort)
	assert_is(map.effects, EffectsPort)
	assert_is(map.effects.traps, TrapEffectsPort)
	assert_is(map.effects.puddle_port, PuddleEffectsPort)
	assert_is(map.effects.puddle_port.queries, PuddleQueriesPort)
	assert_is(map.effects.puddle_port.mutation, PuddleMutationPort)
	assert_is(map.effects.puddle_port.zones, PuddleZoneEffectsPort)
	assert_is(map.effects.delayed, DelayedEffectsPort)
	assert_is(map.obstacles, ObstaclePort)
	assert_is(map.obstacles.rocks, RockPort)
	assert_is(map.obstacles.modules, ModulePort)
	assert_is(map.obstacles.trees, TreePort)
	assert_is(map.obstacles.trees.queries, TreeQueriesPort)
	assert_is(map.obstacles.trees.movement, TreeMovementPort)
	assert_is(map.obstacles.trees.effects, TreeEffectsPort)
	assert_is(map.push, PushPort)
	assert_is(map.push.selection, PushSelectionPort)
	assert_is(map.push.queries, PushQueriesPort)
	assert_is(map.push.execution, PushExecutionPort)
	assert_is(map.push.modules, PushModulesPort)
	assert_is(map.scene, ScenePort)
	assert_is(map.scene, CombatMapSceneAdapter)
	assert_is(map.scene.actors, SceneActorsPort)
	assert_is(map.scene.presentation, ScenePresentationPort)
	assert_is(map.scene.input, SceneInputPort)
	var enemy_board := CombatEnemyBoardMapAdapter.new(map)
	assert_is(enemy_board, EnemyBoardPort)
	assert_is(enemy_board.state, EnemyBoardStatePort)
	assert_is(enemy_board.queries, EnemyBoardQueriesPort)
	assert_is(enemy_board.effects, EnemyBoardEffectsPort)
	assert_is(enemy_board.movement, EnemyBoardMovementPort)
	assert_is(map.state, StatePort)
	assert_is(map.state, CombatMapStateAdapter)
	map.player_pos = Vector2(4.0, 5.0)
	assert_eq(map.state.player_position(), Vector2(4.0, 5.0))
	map.free()


func test_el_adaptador_del_tablero_enemigo_implementa_su_puerto() -> void:
	var map_area := CombatMapArea.new()
	assert_is(CombatEnemyBoardMapAdapter.new(map_area), EnemyBoardPort)
	map_area.free()
