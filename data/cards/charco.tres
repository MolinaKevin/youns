[gd_resource type="Resource" script_class="CardData" format=3 uid="uid://charco00001"]

[ext_resource type="Script" uid="uid://cb2fptd8ugdit" path="res://data/card_data.gd" id="1_charco"]
[ext_resource type="Script" path="res://data/card_action.gd" id="2_action"]
[ext_resource type="Script" path="res://data/card_action_line.gd" id="3_line"]
[ext_resource type="Script" path="res://data/stat_scaling.gd" id="4_scaling"]

[sub_resource type="Resource" id="Scale_Line_bottom"]
script = ExtResource("4_scaling")
base = 18
stat = "agilidad"
factor = 0.4

[sub_resource type="Resource" id="Scale_Line_bottom_2"]
script = ExtResource("4_scaling")
base = 5
stat = "fuerza"
factor = 0.1

[sub_resource type="Resource" id="Scale_Line_top_radius"]
script = ExtResource("4_scaling")
base = 3
stat = "inteligencia"
factor = 0.2

[sub_resource type="Resource" id="Scale_Line_top_duration"]
script = ExtResource("4_scaling")
base = 1
stat = "inteligencia"
factor = 0.04

[sub_resource type="Resource" id="Line_top"]
script = ExtResource("3_line")
card_type = "puddle"
mp_cost = 10
description = "Lanzás un charco de agua. Quien lo pise queda mojado y se mueve más lento."
card_range = 13
throw_range = 88
duration = 3
range_scaling = SubResource("Scale_Line_top_radius")
duration_scaling = SubResource("Scale_Line_top_duration")

[sub_resource type="Resource" id="Line_bottom"]
script = ExtResource("3_line")
card_type = "move"
description = "Te movés."
card_range = 38
range_scaling = SubResource("Scale_Line_bottom")

[sub_resource type="Resource" id="Line_bottom_2"]
script = ExtResource("3_line")
card_type = "melee_attack"
description = "Golpe cuerpo a cuerpo."
damage = 10
damage_scaling = SubResource("Scale_Line_bottom_2")

[sub_resource type="Resource" id="Resource_top"]
script = ExtResource("2_action")
lines = Array[ExtResource("3_line")]([SubResource("Line_top")])
color = Color(0.23, 0.1, 0.32, 1)

[sub_resource type="Resource" id="Resource_bottom"]
script = ExtResource("2_action")
lines = Array[ExtResource("3_line")]([SubResource("Line_bottom"), SubResource("Line_bottom_2")])
color = Color(0.08, 0.26, 0.14, 1)

[resource]
script = ExtResource("1_charco")
id = "charco"
name = "Charco"
initiative = 44
top = SubResource("Resource_top")
bottom = SubResource("Resource_bottom")
metadata/_custom_type_script = "uid://cb2fptd8ugdit"
