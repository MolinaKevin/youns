[gd_resource type="Resource" script_class="YounData" format=3]

[ext_resource type="Script" path="res://data/youns/youn_data.gd" id="script"]
[ext_resource type="Script" path="res://data/youns/youn_stats.gd" id="stats"]
[ext_resource type="Script" path="res://data/youns/youn_evolution_stats.gd" id="evo_stats"]
[ext_resource type="Script" path="res://data/card_action_line.gd" id="line"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition.gd" id="cond"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition_intelligence.gd" id="c_intel"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition_values.gd" id="c_values"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_value_check.gd" id="c_check"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition_hour.gd" id="c_hour"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition_zone.gd" id="c_zone"]
[ext_resource type="Script" path="res://data/youns/evolution/evolution_condition_from_youn.gd" id="c_from"]
[ext_resource type="Resource" path="res://data/cards/meteor.tres" id="signature"]

[sub_resource type="Resource" id="BaseStats"]
script = ExtResource("stats")
constitucion = 150
mente = 90
fuerza = 170
resistencia = 130
agilidad = 120
tecnica = 110
inteligencia = 80
espiritu = 90

[sub_resource type="Resource" id="EvolutionStats"]
script = ExtResource("evo_stats")
mode = 0
constitucion = 40.0
mente = 20.0
fuerza = 70.0
resistencia = 40.0
agilidad = 30.0
tecnica = 20.0
inteligencia = 10.0
espiritu = 10.0

[sub_resource type="Resource" id="Cond0"]
script = ExtResource("c_intel")
intelligences = PackedStringArray("corporal")

[sub_resource type="Resource" id="Cond1Check0"]
script = ExtResource("c_check")
key = "fuerza"
use_min = true
min_value = 110.0

[sub_resource type="Resource" id="Cond1"]
script = ExtResource("c_values")
kind = 1
checks = Array[ExtResource("c_check")]([SubResource("Cond1Check0")])

[sub_resource type="Resource" id="Cond2Check0"]
script = ExtResource("c_check")
key = "care_mistakes"
use_min = true
min_value = 3.0

[sub_resource type="Resource" id="Cond2"]
script = ExtResource("c_values")
kind = 2
checks = Array[ExtResource("c_check")]([SubResource("Cond2Check0")])

[sub_resource type="Resource" id="Cond3"]
script = ExtResource("c_zone")
zone_id = "right"

[sub_resource type="Resource" id="Cond4"]
script = ExtResource("c_from")
youn_path = "res://data/youns/mboi_tui.tres"

[sub_resource type="Resource" id="Line0"]
script = ExtResource("line")
card_type = "melee_attack"
description = "Embestida."
damage = 60

[sub_resource type="Resource" id="Line1"]
script = ExtResource("line")
card_type = "move"
description = "Carrera."
card_range = 30

[resource]
script = ExtResource("script")
id = "luison"
youn_name = "Luisón"
stage = "ultimate"
intelligences = PackedStringArray("corporal")
evolution_conditions = Array[ExtResource("cond")]([SubResource("Cond0"), SubResource("Cond1"), SubResource("Cond2"), SubResource("Cond3"), SubResource("Cond4")])
signature_card = ExtResource("signature")
color_changes = Dictionary[String, int]({"corporal": 3})
granted_lines = Array[ExtResource("line")]([SubResource("Line0"), SubResource("Line1")])
placeholder_shape = 4
placeholder_color = Color(0.25, 0.25, 0.3, 1)
placeholder_size = 1.5
base_stats = SubResource("BaseStats")
evolution_stats = SubResource("EvolutionStats")
body_height = 1.4
