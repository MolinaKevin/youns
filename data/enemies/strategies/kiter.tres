[gd_resource type="Resource" script_class="AiStrategy" format=3]

[ext_resource type="Script" path="res://data/enemies/ai_condition.gd" id="1_Cond"]
[ext_resource type="Script" path="res://data/enemies/ai_phase_transition.gd" id="2_Trans"]
[ext_resource type="Script" path="res://data/enemies/ai_strategy.gd" id="3_Strat"]
[ext_resource type="Script" path="res://data/enemies/ai_phase.gd" id="4_Phase"]
[ext_resource type="Resource" path="res://data/enemies/phases/approach.tres" id="5_Approach"]
[ext_resource type="Resource" path="res://data/enemies/phases/kiting.tres" id="6_Kiting"]
[ext_resource type="Resource" path="res://data/enemies/phases/flee.tres" id="7_Flee"]

[sub_resource type="Resource" id="Cond_InRange"]
script = ExtResource("1_Cond")
type = "player_in_range"
range = 12.0

[sub_resource type="Resource" id="Cond_OutOfRange"]
script = ExtResource("1_Cond")
type = "player_out_of_range"
range = 12.0

[sub_resource type="Resource" id="Cond_HpLow"]
script = ExtResource("1_Cond")
type = "self_hp_low"

[sub_resource type="Resource" id="Trans_ApproachToKiting"]
script = ExtResource("2_Trans")
from_phase = "approach"
conditions = Array[ExtResource("1_Cond")]([SubResource("Cond_InRange")])
target_phase = "kiting"

[sub_resource type="Resource" id="Trans_KitingToFlee"]
script = ExtResource("2_Trans")
from_phase = "kiting"
conditions = Array[ExtResource("1_Cond")]([SubResource("Cond_HpLow")])
target_phase = "flee"

[sub_resource type="Resource" id="Trans_KitingToApproach"]
script = ExtResource("2_Trans")
from_phase = "kiting"
conditions = Array[ExtResource("1_Cond")]([SubResource("Cond_OutOfRange")])
target_phase = "approach"

[resource]
script = ExtResource("3_Strat")
initial_phase = "approach"
phases = Array[ExtResource("4_Phase")]([ExtResource("5_Approach"), ExtResource("6_Kiting"), ExtResource("7_Flee")])
transitions = Array[ExtResource("2_Trans")]([SubResource("Trans_ApproachToKiting"), SubResource("Trans_KitingToFlee"), SubResource("Trans_KitingToApproach")])
